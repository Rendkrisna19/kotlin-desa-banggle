<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvNamaWarga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Pemohon"
                android:textStyle="bold"
                android:textColor="#212121"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tvStatusPengajuan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Pending"
                android:textColor="#FF9800"
                android:textStyle="bold"
                android:textSize="14sp"/>
        </RelativeLayout>

        <TextView
            android:id="@+id/tvJenisSuratDimohon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Jenis Surat: Surat Keterangan Domisili"
            android:textColor="#555555"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvTglPengajuan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tanggal: 19 Mei 2026"
            android:textColor="#777777"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btnDetailPengajuan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Periksa Berkas &amp; Proses"
            android:backgroundTint="#1A237E"
            android:textColor="#FFFFFF"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>