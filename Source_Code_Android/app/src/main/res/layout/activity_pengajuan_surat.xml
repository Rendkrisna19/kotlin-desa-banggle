<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#1A237E"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pengajuan Surat"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pilih jenis surat yang ingin Anda ajukan"
                    android:textColor="#B0BEC5"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- STEP 0: Pilih Jenis Surat (default visible) -->
        <LinearLayout
            android:id="@+id/layoutPilihJenis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Jenis Layanan Surat"
                android:textColor="#212121"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Surat Pindah -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSuratPindah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="10dp"
                app:cardElevation="3dp"
                app:cardUseCompatPadding="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="🏠"
                        android:textSize="28sp"
                        android:gravity="center"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Surat Pindah"
                            android:textColor="#1A237E"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Surat keterangan pindah domisili"
                            android:textColor="#757575"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#1A237E"
                        android:textSize="22sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Surat Tidak Mampu -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSuratTidakMampu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="10dp"
                app:cardElevation="3dp"
                app:cardUseCompatPadding="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="📋"
                        android:textSize="28sp"
                        android:gravity="center"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Surat Tidak Mampu"
                            android:textColor="#1A237E"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Surat keterangan tidak mampu ekonomi"
                            android:textColor="#757575"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#1A237E"
                        android:textSize="22sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Surat Datang -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSuratDatang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="10dp"
                app:cardElevation="3dp"
                app:cardUseCompatPadding="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="🚶"
                        android:textSize="28sp"
                        android:gravity="center"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Surat Datang"
                            android:textColor="#1A237E"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Surat keterangan pendatang baru"
                            android:textColor="#757575"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#1A237E"
                        android:textSize="22sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Permohonan KIA -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSuratKia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="10dp"
                app:cardElevation="3dp"
                app:cardUseCompatPadding="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="👶"
                        android:textSize="28sp"
                        android:gravity="center"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pembuatan KIA"
                            android:textColor="#1A237E"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kartu Identitas Anak (0-17 th)"
                            android:textColor="#757575"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#1A237E"
                        android:textSize="22sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Permohonan KTP -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSuratKtp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="10dp"
                app:cardElevation="3dp"
                app:cardUseCompatPadding="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="🪪"
                        android:textSize="28sp"
                        android:gravity="center"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Permohonan KTP"
                            android:textColor="#1A237E"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pembuatan KTP Baru/Hilang"
                            android:textColor="#757575"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#1A237E"
                        android:textSize="22sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Permohonan KK -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSuratKk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="10dp"
                app:cardElevation="3dp"
                app:cardUseCompatPadding="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="👪"
                        android:textSize="28sp"
                        android:gravity="center"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Permohonan KK"
                            android:textColor="#1A237E"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pembuatan KK Baru/Perubahan"
                            android:textColor="#757575"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#1A237E"
                        android:textSize="22sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- STEP 1-4: Form Multi-Step (hidden by default, shown after jenis selected) -->
        <LinearLayout
            android:id="@+id/layoutFormPengajuan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Label jenis surat terpilih -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#E8EAF6"
                app:cardUseCompatPadding="true"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/tvJenisSelected"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Surat Pindah"
                        android:textColor="#1A237E"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                    <Button
                        android:id="@+id/btnGantiJenis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ganti"
                        android:textSize="12sp"
                        app:backgroundTint="#1A237E"
                        android:textColor="#FFFFFF"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- STEP A: Unduh Form Kosong -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardStepA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="3dp"
                app:cardUseCompatPadding="true"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📥 Langkah 1 — Unduh Form Kosong"
                        android:textColor="#1A237E"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Unduh form kosong, isi secara lengkap, lalu scan/foto dan upload di bawah."
                        android:textColor="#616161"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp"/>
                    <Button
                        android:id="@+id/btnUnduhForm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⬇ Unduh Form Kosong"
                        app:backgroundTint="#1565C0"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- STEP B: Input Nama dan No KTP -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardStepB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="3dp"
                app:cardUseCompatPadding="true"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✏️ Langkah 2 — Data Pemohon"
                        android:textColor="#1A237E"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nama Lengkap"
                        android:textColor="#424242"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etNamaPemohon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Masukkan nama lengkap sesuai KTP"
                        android:inputType="textPersonName|textCapWords"
                        android:padding="12dp"
                        android:background="@android:drawable/edit_text"
                        android:layout_marginBottom="12dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nomor KTP (NIK)"
                        android:textColor="#424242"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etNoKtp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="16 digit Nomor Induk Kependudukan"
                        android:inputType="number"
                        android:maxLength="16"
                        android:padding="12dp"
                        android:background="@android:drawable/edit_text"
                        android:layout_marginBottom="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- STEP C: Upload Dokumen KTP & KK -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardStepC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="3dp"
                app:cardUseCompatPadding="true"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📎 Langkah 3 — Unggah Dokumen Identitas"
                        android:textColor="#1A237E"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Unggah foto/scan KTP dan Kartu Keluarga (KK) sebagai identitas pemohon."
                        android:textColor="#616161"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Upload KTP -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🪪 Foto KTP"
                        android:textColor="#424242"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <Button
                        android:id="@+id/btnUnggahKtp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📂 Unggah KTP"
                        app:backgroundTint="#1565C0"
                        android:textColor="#FFFFFF"/>
                    <TextView
                        android:id="@+id/tvStatusKtp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Belum ada file KTP dipilih"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:gravity="center"/>

                    <!-- Upload KK -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📋 Kartu Keluarga (KK)"
                        android:textColor="#424242"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <Button
                        android:id="@+id/btnUnggahKk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📂 Unggah KK"
                        app:backgroundTint="#2E7D32"
                        android:textColor="#FFFFFF"/>
                    <TextView
                        android:id="@+id/tvStatusKk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Belum ada file KK dipilih"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:gravity="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- STEP D: Submit -->
            <Button
                android:id="@+id/btnSubmitPengajuan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅ Kirim Pengajuan Surat"
                app:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
