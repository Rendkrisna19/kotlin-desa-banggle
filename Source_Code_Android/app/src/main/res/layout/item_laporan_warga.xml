<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvSubjekLaporan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/tvStatusLaporan"
                android:layout_alignParentStart="true"
                android:text="Judul Keluhan / Aspirasi"
                android:textStyle="bold"
                android:textColor="#212121"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvStatusLaporan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Pending"
                android:textStyle="bold"
                android:textSize="13sp"/>
        </RelativeLayout>

        <TextView
            android:id="@+id/tvKategoriLaporan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Kategori: Infrastruktur"
            android:textColor="#1A237E"
            android:textStyle="italic"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tvIsiLaporanSingkat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Isi aduan atau aspirasi dari masyarakat desa..."
            android:textColor="#666666"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvTanggalLaporan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Dikirim oleh: warga123 • 19 Mei 2026"
            android:textColor="#999999"
            android:textSize="11sp"/>

        <Button
            android:id="@+id/btnTindakLanjuti"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Respons &amp; Tindak Lanjuti"
            android:backgroundTint="#1A237E"
            android:textColor="#FFFFFF"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>