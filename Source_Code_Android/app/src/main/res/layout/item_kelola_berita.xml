<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvJudulBerita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Judul Pengumuman"
            android:textStyle="bold"
            android:textColor="#212121"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvTglBerita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Diposting: 19 Mei 2026"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvIsiBeritaSingkat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Isi konten berita..."
            android:textColor="#555555"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp">

            <ImageButton
                android:id="@+id/btnEditBerita"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_edit"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Ubah" />

            <ImageButton
                android:id="@+id/btnHapusBerita"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:src="@android:drawable/ic_menu_delete"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Hapus" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>