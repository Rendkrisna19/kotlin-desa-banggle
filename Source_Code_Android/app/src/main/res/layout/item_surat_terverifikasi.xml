<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvJenisSurat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Surat Keterangan Tidak Mampu"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:textSize="15sp"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/badgeVerified"/>

            <!-- Label penanda lolos verifikasi berkas ganda -->
            <TextView
                android:id="@+id/badgeVerified"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Siap Proses"
                android:textColor="#FFFFFF"
                android:background="#4CAF50"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </RelativeLayout>

        <TextView
            android:id="@+id/tvNamaPemohon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Pemohon: Ovilia Rahmawati"
            android:textColor="#333333"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvNikPemohon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NIK: 350612XXXXXXXXXX"
            android:textColor="#666666"
            android:textSize="13sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginVertical="10dp"/>

        <TextView
            android:id="@+id/tvTanggalMasuk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rekomendasi RT/RW: Disetujui • 20 Mei 2026"
            android:textColor="#999999"
            android:textSize="11sp"
            android:layout_gravity="end"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>