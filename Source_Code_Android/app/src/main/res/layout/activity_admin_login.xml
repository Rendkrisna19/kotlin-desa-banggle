<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#1A237E"> <!-- Tema Biru Gelap Khas Admin -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SISTEM MANAGEMENT"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login Sekretaris &amp; Staf Desa"
        android:textColor="#BBDEFB"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="32dp" />

    <EditText
        android:id="@+id/etAdminUsername"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#FFFFFF"
        android:hint="Username Khusus"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etAdminPassword"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#FFFFFF"
        android:hint="Password"
        android:inputType="textPassword"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnAdminLogin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="MASUK KE SISTEM"
        android:backgroundTint="#FFD54F"
        android:textColor="#1A237E"
        android:textStyle="bold" />
</LinearLayout>