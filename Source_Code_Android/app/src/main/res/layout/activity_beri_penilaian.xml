<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#1A237E"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Penilaian Layanan Desa"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nilai setiap layanan yang telah Anda gunakan"
                    android:textColor="#B0BEC5"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Instruksi -->
        <TextView
            android:id="@+id/tvInstruksiPenilaian"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih layanan surat yang ingin Anda nilai:"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Spinner Layanan -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true"
            android:layout_marginBottom="16dp">
            <Spinner
                android:id="@+id/spinnerLayanan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
        </androidx.cardview.widget.CardView>

        <!-- Form Rating (tersembunyi hingga layanan dipilih) -->
        <LinearLayout
            android:id="@+id/layoutRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <!-- Nama layanan dipilih -->
                    <TextView
                        android:id="@+id/tvLayananDipilih"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⭐ Nilai Layanan"
                        android:textColor="#1A237E"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="16dp"/>

                    <!-- Komponen Rating Bintang -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ketuk Bintang untuk Menilai"
                        android:textColor="#212121"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp"/>

                    <RatingBar
                        android:id="@+id/ratingBarLayanan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:stepSize="1.0"
                        android:rating="0.0"
                        android:progressTint="#FFB300"
                        android:progressBackgroundTint="#BDBDBD"
                        android:layout_marginBottom="24dp"/>

                    <!-- Input Ulasan Tertulis -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ulasan / Kritik &amp; Saran (Opsional)"
                        android:textColor="#212121"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        android:gravity="left"/>

                    <EditText
                        android:id="@+id/etUlasan"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:hint="Tuliskan pengalaman atau saran Anda di sini..."
                        android:inputType="textMultiLine"
                        android:gravity="top|left"
                        android:padding="12dp"
                        android:background="@android:drawable/edit_text"
                        android:layout_marginBottom="24dp"/>

                    <!-- Tombol Kirim -->
                    <Button
                        android:id="@+id/btnKirimRating"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kirim Penilaian"
                        android:backgroundTint="#1A237E"
                        android:textColor="#FFFFFF"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>