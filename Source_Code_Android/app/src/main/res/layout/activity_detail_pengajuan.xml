<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#004D40"
        app:title="Tinjau Dokumen Warga"
        app:titleTextColor="#FFFFFF"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/dtNamaWarga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nama Pengaju: -"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121"/>

            <TextView
                android:id="@+id/dtJenisSurat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jenis Surat: -"
                android:textSize="14sp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/dtKeperluan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keperluan: -"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginVertical="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📎 Dokumen Lampiran Persyaratan:"
                android:textStyle="bold"
                android:textColor="#004D40"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/dtNamaFileKtp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KTP: -"
                android:textColor="#1565C0"
                android:layout_marginTop="4dp"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/dtNamaFileKk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KK: -"
                android:textColor="#1565C0"
                android:layout_marginTop="4dp"
                android:textSize="13sp"/>

            <!-- Tombol untuk Lihat/Unduh Dokumen -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnUnduhKtp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Lihat KTP"
                    android:backgroundTint="#00796B"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/btnUnduhKk"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Lihat KK"
                    android:backgroundTint="#00796B"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- Komponen Tombol Aksi Bersandingan (Kiri & Kanan) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:weightSum="2">

                <!-- Tombol Tolak (Kiri) -->
                <Button
                    android:id="@+id/btnTolakSurat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Tolak"
                    android:backgroundTint="#D32F2F"
                    android:textColor="#FFFFFF"/>

                <!-- Tombol Setujui (Kanan) -->
                <Button
                    android:id="@+id/btnSetujuiSurat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Setujui"
                    android:backgroundTint="#2E7D32"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>