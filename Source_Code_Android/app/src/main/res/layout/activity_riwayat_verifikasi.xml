<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    tools:context=".RiwayatVerifikasiActivity">

    <!-- Header Toolbar Riwayat -->
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#004D40"
        app:title="Riwayat Verifikasi RT/RW"
        app:titleTextColor="#FFFFFF"/>

    <!-- List Daftar Riwayat Surat -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRiwayatVerifikasi"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_pengajuan_surat"/>

</LinearLayout>