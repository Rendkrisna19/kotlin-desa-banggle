<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1A237E"
        app:title="Kelola Persyaratan Berkas"
        app:titleTextColor="#FFFFFF"/>

    <!-- Bagian Form Input Syarat Baru -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvTargetJenisSurat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jenis Surat: -"
                android:textColor="#1A237E"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etInputSyaratBaru"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Masukkan nama berkas syarat (cth: Scan KTP)"
                android:textSize="14sp"
                android:inputType="textCapSentences"/>

            <Button
                android:id="@+id/btnSimpanSyaratBaru"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tambah Persyaratan"
                android:backgroundTint="#1A237E"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daftar Dokumen Wajib Saat Ini:"
        android:textColor="#555555"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"/>

    <!-- List Syarat Tersimpan -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSyaratSurat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"/>

</LinearLayout>