<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F5F5"
    android:orientation="vertical"
    tools:context=".KirimKeluhanActivity">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kirim Keluhan / Aspirasi"
                android:textColor="#1A237E"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sampaikan keluhan atau aspirasi Anda terkait pelayanan infrastruktur dan administrasi desa."
                android:textColor="#616161"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="16dp"/>

            <!-- Kategori Laporan -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jenis Laporan"
                android:textColor="#212121"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <RadioGroup
                android:id="@+id/rgKategori"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/rbKeluhan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keluhan"
                    android:checked="true"
                    android:layout_marginRight="24dp"/>

                <RadioButton
                    android:id="@+id/rbAspirasi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aspirasi"/>
            </RadioGroup>

            <!-- Input Subjek -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Subjek / Judul Laporan"
                android:textColor="#212121"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etSubjek"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Contoh: Jalan rusak di dusun b"
                android:inputType="text"
                android:paddingLeft="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="16dp"/>

            <!-- Input Isi Laporan -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detail Laporan"
                android:textColor="#212121"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etIsiLaporan"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="Ketikkan detail keluhan atau aspirasi Anda di sini..."
                android:inputType="textMultiLine"
                android:gravity="top|left"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="24dp"/>

            <!-- Tombol Kirim -->
            <Button
                android:id="@+id/btnKirimLaporan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kirim Laporan"
                android:backgroundTint="#1A237E"
                android:textColor="#FFFFFF"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>